<Window x:Class="Notakillite.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Notakillite.Desktop" Title="Notakillite" Style="{StaticResource AppWindowStyle}" Width="1280" Height="860" MinWidth="680" MinHeight="520" AllowDrop="True" Drop="OnDrop" Closing="OnClosing" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <HierarchicalDataTemplate DataType="{x:Type local:FolderModel}" ItemsSource="{Binding Children}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▱" Foreground="{Binding Color}" FontSize="19" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center" FontSize="13"/><TextBlock Grid.Column="2" Text="{Binding CountLabel}" Style="{StaticResource Caption}" Margin="7,0,3,0" VerticalAlignment="Center"/></Grid></HierarchicalDataTemplate>
 </Window.Resources>
 <Grid Background="{DynamicResource BackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12"><DockPanel LastChildFill="False">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="FoldersButton" Content="☰" Click="OnToggleFolders" Style="{StaticResource QuietButton}" Visibility="Collapsed" AutomationProperties.Name="Open library folders"/><Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0"><TextBlock Text="≋" FontSize="28" Foreground="{DynamicResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="notakillite" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Your lectures, ready for AI" Style="{StaticResource Caption}" Margin="0,1,0,0"/></StackPanel></StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ConnectButton" MinWidth="142" Click="OnConnect" Padding="12,8" ToolTip="Connect or refresh your usual Brave session"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ConnectionDot" Text="●" Foreground="{DynamicResource WarningBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="Starting…" FontSize="12" VerticalAlignment="Center"/></StackPanel></Button><Button Content="◐" Click="OnToggleTheme" Style="{StaticResource QuietButton}" AutomationProperties.Name="Switch light or dark theme" FontSize="20" ToolTip="Switch light or dark theme"/><Button Content="Settings" Click="OnAccount" Style="{StaticResource QuietButton}"><Button.ContextMenu><ContextMenu><MenuItem Header="Set up Brave connector…" Click="OnSetup"/><MenuItem Header="Show Notability" Click="OnOpenBrave"/><Separator/><MenuItem Header="Groq API key…" Click="OnGroqKey"/><MenuItem Header="Download Whisper model now" Click="OnDownloadModel"/><Separator/><MenuItem Header="Repair audio runtime…" Click="OnRepairRuntime"/><MenuItem Header="Choose export folder…" Click="OnChooseOutput"/><MenuItem Header="Open export folder" Click="OnOpenOutput"/><Separator/><MenuItem Header="Dark theme" Tag="dark" Click="OnTheme"/><MenuItem Header="Light theme" Tag="light" Click="OnTheme"/><MenuItem Header="Follow Windows theme" Tag="system" Click="OnTheme"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Row="1" x:Name="BodyGrid">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="344"/></Grid.ColumnDefinitions>
   <Border x:Name="SidebarPanel" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Panel.ZIndex="9"><DockPanel Margin="12,20,12,14"><StackPanel DockPanel.Dock="Top"><Button x:Name="AllNotesButton" Content="All notes" Click="OnAllNotes" HorizontalContentAlignment="Left" Margin="0,0,0,18"/><TextBlock Text="NOTABILITY LIBRARY" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,11"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="SyncText" Text="One-time setup in your usual Brave profile." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="10,10,5,14"/><Button Content="＋ Import lectures…" Click="OnImport" HorizontalContentAlignment="Center"/><Button Content="Paste  ·  Ctrl+V" Click="OnPaste" HorizontalContentAlignment="Center" Margin="0,6,0,0"/><TextBlock Text="Notability .note, M4A, MP3, WAV, folders" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel><TreeView x:Name="FolderTree" SelectedItemChanged="OnFolderSelected" TreeViewItem.Expanded="OnFolderExpansion" TreeViewItem.Collapsed="OnFolderExpansion" AutomationProperties.Name="Notability folders"/></DockPanel></Border>
   <DockPanel x:Name="LibraryPanel" Grid.Column="1" Margin="24,22,22,10">
    <StackPanel DockPanel.Dock="Top">
     <Border x:Name="ConnectionBanner" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource ControlLineBrush}" BorderThickness="1" CornerRadius="8" Padding="13" Margin="0,0,0,17" Visibility="Collapsed"><DockPanel><Button x:Name="BannerAction" Content="Reconnect" Click="OnConnect" DockPanel.Dock="Right" FontSize="12" Padding="10,5" MinHeight="32" Margin="12,0,0,0" VerticalAlignment="Top"/><StackPanel><TextBlock x:Name="BannerTitle" Text="Connection needs attention" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4"/><TextBlock x:Name="BannerMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19"/></StackPanel></DockPanel></Border>
     <TextBlock x:Name="Breadcrumb" Text="Notability library" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="2,0,0,7"/>
     <DockPanel Margin="0,0,0,18"><Button x:Name="DetailButton" Content="Audio →" Click="OnShowDetails" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Visibility="Collapsed"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="FolderTitle" Text="All notes" FontSize="25" FontWeight="SemiBold"/><Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="9,2" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="NoteCount" Text="0 notes" Style="{StaticResource Caption}"/></Border></StackPanel></DockPanel>
     <Grid><TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="Search all notes" ToolTip="Search all folders, titles and recordings · Ctrl+F"/><TextBlock Text="Search all notes and folders…" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="13,0,65,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="Ctrl F" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
     <DockPanel Margin="0,9,0,11"><CheckBox x:Name="AudioOnly" Content="Audio only" Checked="OnFilterChanged" Unchecked="OnFilterChanged" FontSize="12"/><TextBlock x:Name="SortText" Text="Notability order" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
    </StackPanel>
    <Grid><TextBlock x:Name="LibraryEmpty" Text="Choose a folder to see its notes." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextAlignment="Center" LineHeight="24"/><ListBox x:Name="NoteList" SelectionChanged="OnNoteSelected" AutomationProperties.Name="Notes" ScrollViewer.CanContentScroll="True"><ListBox.ItemTemplate><DataTemplate><Grid MinHeight="47"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="7" Width="32" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Icon}" Foreground="{DynamicResource AccentBrush}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock Text="{Binding Title}" FlowDirection="{Binding Direction}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="14" MaxHeight="43"/><TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Path}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Visibility="{Binding ShowPath, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource Caption}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </DockPanel>
   <Button x:Name="InspectorScrim" Grid.ColumnSpan="3" Background="#88000000" BorderThickness="0" Padding="0" Margin="0" Visibility="Collapsed" Panel.ZIndex="8" Click="OnClosePanels" AutomationProperties.Name="Close side panel"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"/></ControlTemplate></Button.Template></Button>
   <Border x:Name="InspectorPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Panel.ZIndex="10">
    <DockPanel>
     <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="21,15"><StackPanel><DockPanel Margin="0,0,0,10"><TextBlock x:Name="ExportSummary" Text="Select a recording" Style="{StaticResource Caption}"/><TextBlock x:Name="SelectedDuration" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel><Button x:Name="ExportButton" Content="↓  Export for AI" Click="OnExport" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0" MinHeight="44"/><Button x:Name="RuntimeRepairButton" Content="Repair audio runtime…" Click="OnRepairRuntime" Visibility="Collapsed" FontSize="12" Margin="0,8,0,0"/><TextBlock x:Name="OutputSummary" Text="DeepFilterNet3 · MP3 · Keep one file" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" FontSize="11"/></StackPanel></Border>
     <Grid DockPanel.Dock="Top" Margin="21,17,15,0"><TextBlock Text="NOTE AUDIO" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/><Button x:Name="CloseDetailButton" Content="✕" Click="OnClosePanels" Style="{StaticResource QuietButton}" HorizontalAlignment="Right" Visibility="Collapsed" AutomationProperties.Name="Close note audio" MinHeight="28" Padding="7,3"/></Grid>
     <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="21,8,21,15">
      <TextBlock x:Name="DetailTitle" Text="Select a note" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="DetailMeta" Text="Its recordings and export options will appear here." Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="19"/>
      <Separator x:Name="RecordingsSeparator"/><DockPanel><TextBlock x:Name="RecordingsHeading" Text="Recordings" FontWeight="SemiBold" FontSize="13"/><Button Content="Select all" Click="OnSelectAll" Style="{StaticResource QuietButton}" FontSize="12" Foreground="{DynamicResource AccentBrush}" MinHeight="22" Padding="3,0" HorizontalAlignment="Right" Margin="0"/></DockPanel>
      <ItemsControl x:Name="RecordingsList" Margin="0,5,0,0"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontSize="13"/><TextBlock Text="Original recording" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></Grid></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock x:Name="NoRecordingText" Text="Choose a note with audio to export a lecture." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Button x:Name="LoadRecordingsButton" Content="Retry loading recordings" Click="OnLoadRecordings" Visibility="Collapsed" Margin="0,8,0,0"/>
      <Separator/><DockPanel Margin="0,0,0,9"><TextBlock Text="Cleanup" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Runs locally" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
      <Button x:Name="BalancedPreset" Tag="deepfilter" Click="OnPreset" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="11,9"><DockPanel><TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Balanced cleanup" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="DeepFilterNet3 · Detailed speech cleanup" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Button>
      <Button x:Name="FastPreset" Tag="rnnoise" Click="OnPreset" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="11,9"><DockPanel><TextBlock Text="○" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Faster cleanup" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="RNNoise · Lighter processing" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Button>
      <Button x:Name="OriginalPreset" Tag="none" Click="OnPreset" HorizontalContentAlignment="Stretch" Margin="0,0,0,7" Padding="11,9"><DockPanel><TextBlock Text="○" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Original audio" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Keep the source unchanged" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/></StackPanel></DockPanel></Button>
      <Expander Header="Advanced settings" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Noise reduction engine"/><ComboBox x:Name="Engine" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Noise reduction engine"><ComboBoxItem Content="DeepFilterNet3" Tag="deepfilter"/><ComboBoxItem Content="RNNoise" Tag="rnnoise"/><ComboBoxItem Content="RNNoise + DeepFilterNet3" Tag="hybrid"/><ComboBoxItem Content="Light cleanup" Tag="classic"/><ComboBoxItem Content="Original · unchanged" Tag="none"/></ComboBox><TextBlock x:Name="EngineDescription" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/><TextBlock Text="Strength"/><ComboBox x:Name="Strength" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Cleanup strength"><ComboBoxItem Content="Balanced" Tag="balanced"/><ComboBoxItem Content="Strong" Tag="strong"/></ComboBox><TextBlock Text="Split recording"/><ComboBox x:Name="Split" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Split recording"><ComboBoxItem Content="Keep one file" Tag="0"/><ComboBoxItem Content="10 minutes" Tag="10"/><ComboBoxItem Content="20 minutes" Tag="20"/><ComboBoxItem Content="30 minutes" Tag="30"/></ComboBox></StackPanel></Expander>
      <Separator/><TextBlock Text="Processing preset / إعداد المعالجة"/><ComboBox x:Name="ProcessingPreset" SelectionChanged="OnProcessingPreset" SelectedIndex="3"><ComboBoxItem Content="Fast · turbo, original" Tag="fast"/><ComboBoxItem Content="Balanced · turbo, RNNoise" Tag="balanced"/><ComboBoxItem Content="Accuracy · large-v3, RNNoise" Tag="accuracy"/><ComboBoxItem Content="Custom / مخصص" Tag="custom"/></ComboBox>
      <TextBlock Text="Resources / الموارد"/><ComboBox x:Name="ResourcePolicy" SelectedIndex="0"><ComboBoxItem Content="Automatic / تلقائي" Tag="auto"/><ComboBoxItem Content="Background / خلفية" Tag="background"/><ComboBoxItem Content="Maximum throughput / أقصى سرعة" Tag="maximum"/></ComboBox>
      <CheckBox x:Name="OcrBox" Content="OCR scanned PDFs (local Tesseract)"/><Button Content="Attach lecture PDFs / إرفاق PDF" Click="OnAttachPdfs"/><Button Content="Clear PDFs / إزالة المرفقات" Click="OnClearPdfs"/><Button Content="Search transcripts / بحث النصوص" Click="OnFindTranscripts"/><Button Content="Check readiness / فحص الجاهزية" Click="OnPreflight"/><Button Content="Processing resources / موارد الجهاز" Click="OnResourceInfo"/><TextBlock x:Name="PdfSummary" Text="Audio only / صوت فقط" TextWrapping="Wrap"/>
      <Separator/><DockPanel Margin="0,0,0,9"><TextBlock Text="Transcript" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="TranscriptWhere" Text="Runs locally" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
      <CheckBox x:Name="TranscribeBox" Content="Make a text transcript (.md) for ChatGPT or Claude" IsChecked="True" Checked="OnTranscriptToggled" Unchecked="OnTranscriptToggled" FontSize="12" Margin="0,0,0,10"/>
      <StackPanel x:Name="TranscriptOptions" TextElement.FontSize="12">
       <TextBlock Text="Speech-to-text engine"/><ComboBox x:Name="Transcriber" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Speech-to-text engine"><ComboBoxItem Content="Whisper on this PC · free, private" Tag="local"/><ComboBoxItem Content="Groq cloud · free tier, fastest" Tag="groq"/></ComboBox>
       <TextBlock Text="Lecture language"/><ComboBox x:Name="LanguageBox" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Lecture language"><ComboBoxItem Content="Auto · Arabic and English mixed" Tag="auto"/><ComboBoxItem Content="Arabic" Tag="ar"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
       <TextBlock Text="Accuracy"/><ComboBox x:Name="Model" SelectionChanged="OnOptionsChanged" AutomationProperties.Name="Whisper model"><ComboBoxItem Content="Fast · large-v3-turbo (874 MB)" Tag="turbo"/><ComboBoxItem Content="Best · large-v3 (3.1 GB, slower)" Tag="large-v3"/></ComboBox>
       <TextBlock Text="Course / المقرر"/><TextBox x:Name="CourseName" MaxLength="200"/><WrapPanel><Button Content="Save dictionary / حفظ القاموس" Click="OnSaveCourse"/><Button Content="Load / تحميل" Click="OnLoadCourse"/></WrapPanel><TextBlock Text="Course vocabulary (optional)"/><TextBox x:Name="Vocabulary" TextChanged="OnVocabularyChanged" MaxLength="600" TextWrapping="Wrap" MinHeight="34" AutomationProperties.Name="Course vocabulary" ToolTip="Drug names, anatomy terms or names the lecturer uses. Helps Whisper spell them."/>
       <TextBlock x:Name="TranscriptStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
       <Button x:Name="TranscriptAction" Click="OnTranscriptAction" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
      </StackPanel>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
   <Border x:Name="WelcomePanel" Grid.ColumnSpan="3" Background="{DynamicResource BackgroundBrush}" Panel.ZIndex="5"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"><StackPanel x:Name="WelcomeStack" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"><Border x:Name="WelcomeMark" Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Width="60" Height="60" Margin="0,0,0,24"><TextBlock Text="≋" Foreground="{DynamicResource AccentBrush}" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="WelcomeTitle" Text="Lecture audio in.&#10;Clean text for AI out." FontSize="31" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,15"/><TextBlock x:Name="WelcomeIntro" Text="Import Notability notes (.note), audio files or a whole folder. Notakillite removes background noise like air conditioning and writes one transcript per lecture, ready for ChatGPT or Claude." Foreground="{DynamicResource MutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" LineHeight="25" Margin="10,0,10,24"/><WrapPanel HorizontalAlignment="Center"><Button Content="＋ Import lectures…" Click="OnImport" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/><Button Content="Paste  ·  Ctrl+V" Click="OnPaste" Margin="0,0,10,8"/><Button x:Name="WelcomeConnect" Content="Connect Notability web" Click="OnConnect" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="WelcomeStatus" Text="In Notability: open the note → Share/Export → Note format (includes recordings) → save it to this PC, then import or paste it here." Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="10,20,10,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBrush}" Padding="18,7"><DockPanel><DockPanel DockPanel.Dock="Top"><Button x:Name="QueueToggle" Content="↓  Exports  ⌄" Click="OnToggleQueue" Style="{StaticResource QuietButton}" DockPanel.Dock="Left" FontSize="12"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Open exports" Click="OnOpenOutput" Style="{StaticResource QuietButton}" FontSize="12"/><Button Content="Clear completed" Click="OnClearCompleted" Style="{StaticResource QuietButton}" FontSize="12"/></StackPanel><TextBlock x:Name="QueueHeading" Text="No exports yet" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="12,0"/></DockPanel>
   <ListBox x:Name="QueueList" Visibility="Collapsed" MaxHeight="210" AutomationProperties.Name="Export queue"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Badge}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding NeedsReview}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><StackPanel Grid.Column="1" Margin="4,0,16,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Recording}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="{Binding Phase}" FontSize="12"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" MaxHeight="50"/><ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}" Height="4" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0" Margin="0,6,0,0"/><TextBlock Text="{Binding Engine}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0"/></StackPanel><WrapPanel Grid.Column="3" MaxWidth="360" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Copy text" Click="OnCopyTranscript" Visibility="{Binding HasTranscript, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5" ToolTip="Copy the transcript to paste into ChatGPT or Claude"/><Button Content="Review / مراجعة" Click="OnReviewTranscript" Visibility="{Binding HasTranscript, Converter={StaticResource BoolVisibility}}" FontSize="12"/><Button Content="Pause" Click="OnPauseJob" Visibility="{Binding CanPause, Converter={StaticResource BoolVisibility}}"/><Button Content="Resume" Click="OnResumeJob" Visibility="{Binding IsPaused, Converter={StaticResource BoolVisibility}}"/><Button Content="Open text" Click="OnOpenTranscript" Visibility="{Binding HasTranscript, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5"/><Button Content="Preview" Click="OnPreviewJob" Visibility="{Binding CanPlay, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5"/><Button Content="Folder" Click="OnRevealJob" Visibility="{Binding CanPlay, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5"/><Button Content="Copy path" Click="OnCopyJob" Visibility="{Binding CanPlay, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5"/><Button Content="{Binding RetryLabel}" Click="OnRetryJob" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5" ToolTip="Run the export again; parts that need review are re-transcribed from the original audio"/><Button Content="Copy diagnostics" Click="OnCopyDiagnostics" Visibility="{Binding NeedsReview, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5" ToolTip="Copy the technical log for this job (no audio or transcript text)"/><Button Content="Cancel" Click="OnCancelJob" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" FontSize="12" Padding="9,5"/></WrapPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <Border x:Name="PlaybackPanel" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,8"><DockPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Play / Pause" Click="OnPlayPause" FontSize="12"/><Button Content="Stop" Click="OnStopPlayback" FontSize="12"/><TextBlock x:Name="PlaybackTime" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0"/></StackPanel><TextBlock x:Name="PlaybackTitle" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Border>
  <Border Grid.Row="4" Background="{DynamicResource SidebarBrush}" Padding="18,4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Starting your saved workspace…" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
  <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Hidden" Width="0" Height="0" MediaFailed="OnMediaFailed"/>
 </Grid>
</Window>
