{
  "manifest_version": 3,
  "name": "Notakillite — Notability audio for AI",
  "version": "0.3.0",
  "description": "Export recordings from your signed-in Notability web account, with optional local speech cleanup.",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://notability.com/*",
    "http://127.0.0.1:43188/*"
  ],
  "action": {
    "default_title": "Notakillite",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker-0.3.0.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notability.com/app*"
      ],
      "js": [
        "adapter.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notability.com/app*"
      ],
      "js": [
        "rpc.js",
        "transfer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:43188"
  },
  "key": ""
}
