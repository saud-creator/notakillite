{
  "manifest_version": 3,
  "name": "Notakillite Brave Connector",
  "version": "0.6.0",
  "description": "Connect your regular Brave Notability session to the local Notakillite desktop app. Audio processing stays on your computer.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "scripting", "storage", "alarms"],
  "host_permissions": ["https://notability.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Connect Notakillite", "default_popup": "connect.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "key": ""
}
